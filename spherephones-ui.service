[Unit]
Description=spherephones UI (HTTP -> OSC bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/spherephones-ui
Environment=BELA_HOST=127.0.0.1
Environment=BELA_PORT=9000
Environment=HTTP_PORT=3001
Environment=LOG_OSC=0
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
